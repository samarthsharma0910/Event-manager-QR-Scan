# PostgreSQL connection string (Supabase / Neon / Railway / local)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/greenbridge?schema=public"

# Long random secret used to sign session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Public base URL of the app (used in password-reset links)
NEXTAUTH_URL="http://localhost:3000"

# IANA timezone in which event times are shown for check-in timestamps
APP_TIMEZONE="Asia/Kolkata"
